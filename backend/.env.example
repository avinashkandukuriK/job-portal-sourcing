# --- Supabase (required for persistence) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_your_publishable_key
# For backend write access, use the service-role key (get from Supabase dashboard → Settings → API):
# SUPABASE_SERVICE_KEY=

# --- GitHub (free, but token strongly recommended: 60 -> 5000 req/hr) ---
GITHUB_TOKEN=

# --- Stack Overflow (free, optional key for higher quota) ---
STACKEXCHANGE_KEY=

# --- Paid adapters (optional — leave blank to disable) ---
APOLLO_API_KEY=
PROXYCURL_API_KEY=
INDEED_PUBLISHER_ID=
DICE_API_KEY=
MONSTER_API_KEY=
ZIPRECRUITER_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
